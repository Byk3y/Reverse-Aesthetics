# ---------------------------------------------------------------
# Supabase — powers the blog and the /admin section
# Copy this file to .env.local and fill in your project's values.
# Dashboard → Project Settings → API
# ---------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose in the browser — every table is
# protected by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# The service-role key is deliberately NOT used by this app.
# Everything writes through the signed-in admin's session so RLS stays in
# force. Don't add it here — a leaked service-role key bypasses all policies.
#
# The two write paths that have no session — the public intake form and the
# Cal.com webhook — go through security-definer functions instead
# (submit_intake, ingest_cal_booking in 0004_patient_crm.sql). Those can only
# insert, never read, so the blast radius of a leak is junk rows rather than
# the entire patient directory.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Cal.com → patient CRM webhook
# Both city accounts post to /api/cal/webhook. Without these the route
# returns 503 and bookings simply don't reach the directory — the booking
# itself still works, so this is safe to leave blank until you're ready.
# ---------------------------------------------------------------

# The signing secret you set on the Cal webhook (Settings → Developer →
# Webhooks). Comma-separate them if Lagos and Abuja use different secrets.
CAL_WEBHOOK_SECRET=

# Second lock, checked inside ingest_cal_booking(). Must equal the value in
# the app_secrets table:
#   insert into app_secrets (key, value) values ('cal_webhook_token', '<token>')
#     on conflict (key) do update set value = excluded.value;
CAL_INGEST_TOKEN=

# ---------------------------------------------------------------
# Analytics & search engine ownership
# All four are optional — the site renders no tags at all when they're blank,
# so it is safe to ship before the client's Google accounts exist.
# ---------------------------------------------------------------

# GA4 measurement ID, e.g. G-XXXXXXXXXX. Setting this turns app/lib/track.ts
# from a no-op into real conversion reporting (booking_submitted, whatsapp_click).
NEXT_PUBLIC_GA_ID=

# GTM container, e.g. GTM-XXXXXXX. Takes precedence over GA_ID if both are set.
# Use this one if Google Ads remarketing tags are also going on the site.
NEXT_PUBLIC_GTM_ID=

# Search Console ownership token — the content="..." value from the
# "HTML tag" method. Optional: prefer verifying as a *Domain property* with a
# DNS TXT record in Hostinger instead. DNS verification works before the new
# site is live (so you can capture the pre-launch baseline), covers www and
# non-www, and survives the host migration. This tag is a useful second method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership token (msvalidate.01). Optional, but Bing
# feeds ChatGPT's web search, so it is cheap AI-visibility insurance.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
